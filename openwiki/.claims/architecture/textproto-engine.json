    {
      "id": "claim_c04c50c5339e47bbae09070445eb86cf",
      "statement": "The engine's contract is byte-exact round-tripping: serialize_textproto(parse_textproto(fixture)) == fixture for the verified Defold 1.14.1 fixtures (a full .go, the double-escaped .collection, and a scalar suite), and parse(serialize(tree)) == tree for mutated trees — with the serializer's optional extension parameter defaulting to insertion-order preservation, the contract holds for every fixture.",
      "evidence": [
        {
          "resource": "repo://src/defold_mcp/textproto/serializer.py#L297-L311",
          "version": "repo-lines-v1:sha256:90368853a0f5079a6a47c9c9039af2057cb1e867e1645dcde82e7d8789232e61:"
        },
        {
