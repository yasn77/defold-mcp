{
  "openapi": "3.0.0",
  "info": {
    "title": "Defold Editor API",
    "version": "1.14.1"
  },
  "paths": {
    "/command/compile": {
      "post": {
        "operationId": "commandCompile",
        "summary": "Compile the current project",
        "responses": {
          "200": {"description": "Compilation succeeded"},
          "422": {"description": "Compilation failed; issues reported"}
        }
      }
    },
    "/command/run": {
      "post": {
        "operationId": "commandRun",
        "summary": "Compile and launch the debug engine",
        "parameters": [
          {
            "name": "focus",
            "in": "query",
            "schema": {"type": "boolean"},
            "description": "Steal window focus when true"
          }
        ],
        "responses": {"200": {"description": "Launched"}}
      }
    },
    "/command/hot-reload": {
      "post": {
        "operationId": "commandHotReload",
        "summary": "Hot-reload changed resources",
        "responses": {"200": {"description": "Reloaded"}}
      }
    },
    "/command/fetch-libraries": {
      "post": {
        "operationId": "commandFetchLibraries",
        "summary": "Fetch missing library dependencies",
        "responses": {"200": {"description": "Fetched"}}
      }
    },
    "/command/clean-build": {
      "post": {
        "operationId": "commandCleanBuild",
        "summary": "Delete build artifacts and recompile",
        "responses": {"200": {"description": "Clean build started"}}
      }
    },
    "/command/build-html5": {
      "post": {
        "operationId": "commandBuildHtml5",
        "summary": "Build the HTML5 target",
        "responses": {"200": {"description": "Built; served at /html5/"}}
      }
    },
    "/command/reload-extensions": {
      "post": {
        "operationId": "commandReloadExtensions",
        "summary": "Reload extension modules",
        "responses": {"200": {"description": "Extensions reloaded"}}
      }
    },
    "/preview/{path}": {
      "get": {
        "operationId": "preview",
        "summary": "Render a resource to PNG",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          },
          {"name": "width", "in": "query", "schema": {"type": "integer"}},
          {"name": "height", "in": "query", "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {"description": "PNG bytes"},
          "404": {"description": "Resource not found"},
          "422": {"description": "Unsupported resource type"}
        }
      }
    },
    "/console": {
      "get": {
        "operationId": "console",
        "summary": "Fetch the console buffer",
        "responses": {"200": {"description": "Console lines and regions"}}
      }
    },
    "/console/stream": {
      "get": {
        "operationId": "consoleStream",
        "summary": "Chunked console stream",
        "responses": {"200": {"description": "Chunked stream"}}
      }
    },
    "/ref": {
      "get": {
        "operationId": "ref",
        "summary": "Version-exact API documentation search",
        "parameters": [
          {"name": "q", "in": "query", "schema": {"type": "string"}},
          {"name": "environment", "in": "query", "schema": {"type": "string"}},
          {"name": "language", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Search results"}}
      }
    },
    "/bob": {
      "post": {
        "operationId": "bob",
        "summary": "Run bob commands (bearer auth required)",
        "responses": {
          "200": {"description": "Result"},
          "401": {"description": "Missing or bad bearer token"}
        }
      }
    },
    "/eval": {
      "post": {
        "operationId": "eval",
        "summary": "Evaluate a Lua 5.2 script in the editor VM (bearer auth required)",
        "responses": {
          "200": {"description": "JSON-encoded last expression"},
          "422": {"description": "Lua error in the payload"},
          "503": {"description": "Extension VM still initialising"}
        }
      }
    }
  }
}
